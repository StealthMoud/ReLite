<?xml version="1.0" encoding="utf-8"?>
<!-- Section 26-31 (v0.5.0 completion pass): a real 2x2-cell expanded
     folder — a title plus up to 4 directly-launchable member icons,
     rather than the compact 1x1 static preview bitmap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/grid_cell_padding"
    android:background="@drawable/bg_folder">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/expanded_folder_title"
            style="@style/AppIconLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="4dp" />

        <android.widget.GridLayout
            android:id="@+id/expanded_folder_members"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="2"
            android:rowCount="2" />

    </LinearLayout>

</FrameLayout>
