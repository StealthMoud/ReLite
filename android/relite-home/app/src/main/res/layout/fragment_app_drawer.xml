<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/relite_background">

    <!-- Section 88 (v0.5.0): the Apps screen search bar moved to the bottom
         in current One UI, explicitly for one-handed reach — see
         docs/design/one-ui-current-reference.md. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/drawer_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/grid_cell_padding" />

    <!-- The Apps screen pages horizontally in Custom order, and until now
         gave no indication of how many pages there were or which one was
         showing. One UI shows the same indicator here as on Home. Hidden
         automatically for a single page, and in Alphabetical order, which
         scrolls vertically (see AppDrawerFragment.applySortModeToLayout). -->
    <io.relite.home.ui.home.PageIndicatorView
        android:id="@+id/drawer_page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/drawer_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dock"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:importantForAccessibility="no" />

        <EditText
            android:id="@+id/drawer_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target_min"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:hint="@string/drawer_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/drawer_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/action_more" />
    </LinearLayout>

</LinearLayout>
