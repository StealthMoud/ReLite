<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <!-- No background here: the window itself shows the system wallpaper
         (Theme.ReliteHome.Home) — painting an opaque color over this root
         view would hide it again. -->

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/home_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/page_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <io.relite.home.ui.home.PageIndicatorView
        android:id="@+id/page_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/dock" />

    <io.relite.home.ui.home.WorkspaceDockView
        android:id="@+id/dock"
        android:layout_width="0dp"
        android:layout_height="@dimen/dock_height"
        android:layout_marginHorizontal="@dimen/dock_margin_horizontal"
        android:layout_marginBottom="@dimen/dock_margin_bottom"
        android:background="@drawable/bg_dock"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/relite_background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Section 4-6: floating layer for the cross-page drag proxy — sits
         above the pager so a dragged icon keeps rendering while ViewPager2
         swaps the page fragment beneath it. Never intercepts touches on
         its own; only ever holds children while a drag is in progress. -->
    <FrameLayout
        android:id="@+id/drag_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Section 112-119 (v0.5.0): the Home edit-mode surface — replaces the
         previous plain AlertDialog on long-press-empty-Home. Sits above
         everything else; the workspace itself scales down slightly behind
         it (MainActivity.enterEditMode) rather than living inside this
         overlay, so the real pager/dock keep rendering normally. -->
    <FrameLayout
        android:id="@+id/edit_mode_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:background="#66000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="48dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/edit_mode_page_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_dock"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/edit_mode_wallpaper"
                style="@style/EditModeAction"
                android:text="@string/action_wallpaper_and_style" />

            <TextView
                android:id="@+id/edit_mode_widgets"
                style="@style/EditModeAction"
                android:text="@string/action_widgets" />

            <TextView
                android:id="@+id/edit_mode_settings"
                style="@style/EditModeAction"
                android:text="@string/action_home_settings" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
