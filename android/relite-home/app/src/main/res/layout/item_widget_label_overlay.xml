<?xml version="1.0" encoding="utf-8"?>
<!-- Section 64 (v0.5.0 completion pass): the "Show widget labels" opt-in
     overlay — a small scrim strip pinned to the bottom of a widget cell,
     never part of the widget provider's own view tree (see
     HomePageFragment.buildWidgetView). Not announced to accessibility
     services on its own since the AppWidgetHostView it's layered onto
     already carries an equivalent contentDescription. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AppIconLabel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="#99000000"
    android:paddingHorizontal="6dp"
    android:paddingVertical="3dp"
    android:textColor="#FFFFFFFF"
    android:importantForAccessibility="no"
    android:clickable="false"
    android:focusable="false" />
