<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReliteHome" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/relite_background</item>
        <item name="colorPrimary">@color/relite_primary</item>
        <item name="android:textColorPrimary">@color/relite_text_primary</item>
        <item name="android:textColorSecondary">@color/relite_text_secondary</item>
    </style>

    <style name="Theme.ReliteHome.Home">
        <item name="android:windowBackground">@color/relite_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.ReliteHome.FolderDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_folder</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>

    <style name="AppIconLabel">
        <item name="android:textColor">@color/relite_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
