<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReliteHome" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:colorBackground">@color/relite_background</item>
        <item name="colorPrimary">@color/relite_primary</item>
        <!--
            Deliberately NO colorPrimaryDark. Setting it painted the system
            status bar solid blue — caught immediately on the RMX5303, and
            wrong for a launcher, whose status bar must stay transparent so
            the wallpaper shows through behind it.
        -->
        <!--
            One UI Design Guidelines (Visual Design 02. Color, p.62) maps
            "Color control activated" to checkboxes, radio buttons and
            switches specifically. Before this was set, colorPrimary alone
            left every AppCompat control on the Settings screen drawing in
            AppCompat's *default* accent rather than this launcher's palette
            — the toggles were visibly the wrong color.
        -->
        <item name="colorAccent">@color/relite_primary</item>
        <item name="colorControlActivated">@color/relite_control_activated</item>
        <item name="android:textColorPrimary">@color/relite_text_primary</item>
        <item name="android:textColorSecondary">@color/relite_text_secondary</item>
    </style>

    <!--
        Section 72: the home screen shows the system wallpaper — the system
        compositor renders it directly behind this window, so ReLite Home
        never decodes a wallpaper bitmap itself. windowBackground is null
        rather than an opaque color so the wallpaper isn't painted over.
    -->
    <style name="Theme.ReliteHome.Home">
        <item name="android:windowShowWallpaper">true</item>
        <!--
            Explicitly transparent, not @null. With @null there is no window
            background drawable at all and the framework falls back to the
            theme's android:colorBackground — this launcher's opaque dark
            neutral — which painted a solid black sheet over the system
            wallpaper. Observed on the RMX5303: Home rendered pure black
            while a real ImageWallpaper was set and visible under every
            other launcher. This is the value AOSP's own launcher themes
            use for the same reason.
        -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!--
            Explicitly transparent system bars. The wallpaper is rendered by
            the compositor behind this window, so anything opaque here (a
            themed status-bar color, for instance) would paint a band over
            it — exactly what a stray colorPrimaryDark did on the RMX5303
            before this was pinned down.
        -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.ReliteHome.FolderDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_folder</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
    </style>

    <style name="AppIconLabel">
        <item name="android:textColor">@color/relite_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
    </style>

    <!--
        Labels on the *home screen*, which sit directly on the user's
        wallpaper rather than on one of this app's own surfaces.

        A theme-coloured label cannot work there: the wallpaper is arbitrary,
        so a dark-theme label goes near-white and vanishes over a light
        wallpaper, while a light-theme label vanishes over a dark one. This
        was plainly visible on the RMX5303 — "Calculator", "Play Store" and
        "Settings" washed out completely against the bright part of the
        wallpaper. Every launcher solves this the same way, One UI included:
        a fixed white label with a soft drop shadow, which stays readable
        over both extremes without needing to know anything about the image
        behind it.

        The drawer keeps plain [AppIconLabel] — it draws on an opaque
        background where the theme colour is correct and a shadow would just
        be grime.
    -->
    <style name="HomeIconLabel" parent="AppIconLabel">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <!-- Section 112-117 (v0.5.0): the three primary Home edit-mode bottom actions. -->
    <style name="EditModeAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/relite_text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!--
        A settings group rendered as a One UI focus block (Architecture 01,
        p.8) rather than rows sitting directly on the background. The side
        margin is the guide's 24dp safe-area minimum (Architecture 04, p.14).
    -->
    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_focus_block</item>
        <item name="android:layout_marginHorizontal">@dimen/screen_margin_horizontal</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <!--
        A row-style button inside a settings focus block. `textAllCaps=false`
        is the point: Android's default borderless button style shouts
        "SORT"/"EXPORT LAYOUT" in caps, while One UI's typography rule is to
        "capitalize the first letter in every word and sentence... while
        leaving all other letters as lowercase" (Visual Design 03, p.65).
        ALL CAPS is the single most obvious way a button reads as stock
        Android rather than One UI.
    -->
    <style name="SettingsButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/relite_text_primary</item>
    </style>

    <!-- Section 120 (v0.5.0): sectioned Home Settings styles. -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- Aligned to the focus block it labels, which sits at the 24dp
             safe-area margin (Architecture 04, p.14) plus the card's own
             internal padding. -->
        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/relite_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsToggleRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">4dp</item>
    </style>

    <style name="SettingsToggleLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/relite_text_primary</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Section 123-124: a tappable grid-size card, not a text-only radio choice. -->
    <style name="GridPresetCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_dock</item>
        <item name="android:textColor">@color/relite_text_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
